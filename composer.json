{
    "name": "byd/voice-assistant",
    "description": "BYD AI Voice Assistant Backend - PHP 8.3+",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "predis/predis": "^2.2",
        "firebase/php-jwt": "^6.10",
        "smalot/pdfparser": "^2.9",
        "monolog/monolog": "^3.6",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "BYD\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "BYD\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate": "php database/migrate.php",
        "worker": "php workers/queue_worker.php",
        "serve": "php -S localhost:8080 -t public"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "source"
    },
    "minimum-stability": "stable"
}
